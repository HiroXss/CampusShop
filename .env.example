APP_NAME="CampusShop"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES
APP_TIMEZONE=America/Bogota

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=campushop
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-responder@campushop.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Parámetros de negocio de CampusShop (sección 8.5 del SRS) ---
# Dominio universitario permitido para el registro (RN-01)
UNIVERSITY_EMAIL_DOMAIN=unimisionpaz.edu.co
# ¿Exigir aprobación del administrador a los emprendimientos nuevos? (RN-02)
REQUIRE_APPROVAL=true
# Máximo de imágenes por producto (RN-10)
MAX_IMAGES_PER_PRODUCT=5
# Tamaño máximo por imagen en KB (RN-10)
MAX_IMAGE_SIZE_KB=2048
# Reportes pendientes que ocultan un elemento (RN-11)
REPORTS_THRESHOLD=3
# Intervalo de actualización del chat en segundos (RF-33)
CHAT_POLL_SECONDS=10
# Elementos por página (RF-14, RF-23)
PAGE_SIZE=12
# Emprendimientos destacados en el inicio (RN-09)
FEATURED_LIMIT=8
# Ventana de los productos más vendidos en días (RN-09)
TOP_SELLING_DAYS=30
# Reseñas mínimas para el ranking de mejor calificados (RN-09)
MIN_REVIEWS_FOR_RANKING=3
# Pedidos por usuario y hora (RNF-13)
MAX_ORDERS_PER_HOUR=10
# Mensajes por usuario y minuto (RNF-13)
MAX_MESSAGES_PER_MINUTE=30
# Intentos de inicio de sesión por minuto (RNF-13)
MAX_LOGIN_ATTEMPTS=5